# Sentinel Vault — Frontend Environment Configuration
# Set this in your Vercel Project Settings > Environment Variables

# The full URL of your deployed Render backend API, including the /api path prefix.
# Example for Render default domain:
NEXT_PUBLIC_API_URL=https://sentinel-vault-api.onrender.com/api

# Example for custom domain:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
