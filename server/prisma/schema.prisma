// Zero-knowledge password vault — metadata-only schema.
// The server NEVER sees plaintext master passwords, vault keys, or item contents.
// Ciphertext blobs are opaque to the server; all encryption/decryption happens client-side.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  // Server-side hash of the client-computed auth hash (double hashing — see docs/02-cryptographic-architecture.md)
  authHash                    String
  // KDF parameters used client-side to derive the Master Key from the master password.
  kdfSalt                     String
  kdfMemoryKb                 Int       @default(65536)
  kdfIterations               Int       @default(3)
  kdfParallelism              Int       @default(4)
  // The Vault Key, randomly generated client-side, encrypted under the Master Key (AES-256-GCM). Opaque blob.
  encryptedVaultKeyCiphertext String
  encryptedVaultKeyIv          String
  // Progressive lockout tracking
  failedLoginAttempts         Int       @default(0)
  lockoutUntil                DateTime?
  lastLoginAt                 DateTime?
  lastLoginIp                 String?
  createdAt                   DateTime  @default(now())

  folders       Folder[]
  vaultItems    VaultItem[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  passkeys      Passkey[]
  mfaMethods    MfaMethod[]
  recoveryCodes RecoveryCode[]
  auditEvents   AuditEvent[]
  tags          Tag[]
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily       String    @default(uuid())
  lastTokenHash     String
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  browser           String?
  os                String?
  createdAt         DateTime  @default(now())
  lastActiveAt      DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  signCount    Int       @default(0)
  deviceType   String?
  name         String?
  transports   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

model MfaMethod {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String    // "TOTP" | "WEBAUTHN"
  secretEncrypted String?   // Encrypted TOTP secret
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  batchId   String?
  expiresAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Folder {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameCiphertext String
  nameIv         String
  createdAt      DateTime  @default(now())

  vaultItems VaultItem[]
}

enum VaultItemType {
  LOGIN
  SECURE_NOTE
  CARD
  IDENTITY
  SSH_KEY
  API_CREDENTIAL
}

model VaultItem {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId          String?
  folder            Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  type              VaultItemType
  favorite          Boolean       @default(false)
  ciphertext        String
  iv                String
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  passwordChangedAt DateTime      @default(now())

  versions    VaultItemVersion[]
  attachments Attachment[]
  tags        ItemTag[]
}

model VaultItemVersion {
  id         String    @id @default(uuid())
  itemId     String
  item       VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ciphertext String
  iv         String
  createdAt  DateTime  @default(now())
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#10b981")
  createdAt DateTime @default(now())

  items ItemTag[]

  @@unique([userId, name])
}

model ItemTag {
  itemId String
  tagId  String
  item   VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

model Attachment {
  id                  String    @id @default(uuid())
  itemId              String
  item                VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storageKey          String    @unique
  ciphertextSizeBytes Int
  iv                  String
  filenameCiphertext  String
  filenameIv          String
  createdAt           DateTime  @default(now())
}

model AuditEvent {
  id        String   @id @default(uuid())
  sequence  Int      @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  metadata  Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())
}
