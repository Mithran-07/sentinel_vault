# ==============================================================================
# Sentinel Vault — Production Backend Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# Must use TLS in production (?sslmode=require)
DATABASE_URL="postgresql://vault:vault@localhost:5432/vault?schema=public&sslmode=prefer"

# Execution Mode: development | test | production
NODE_ENV="development"

# Server Port (Render automatically sets PORT in production)
PORT=4000

# Trusted Frontend Origin (Exact URL of the deployed Vercel frontend)
# Used for CORS and cookie origin verification
CLIENT_ORIGIN="http://localhost:3000"

# Backend Public API URL (Used for SSO OAuth/OIDC callback generation)
API_URL="http://127.0.0.1:4000"

# ── Cryptographic & Authentication Secrets ──────────────────────────────────
# Must be distinct, cryptographically random (openssl rand -hex 32), and >=32 chars in production
JWT_ACCESS_SECRET="change-me-to-a-secure-32-byte-secret-for-access-tokens"
JWT_REFRESH_SECRET="change-me-to-a-secure-32-byte-secret-for-refresh-tokens"

# Server-Side Key for Encrypting TOTP/MFA Seeds at Rest
# In production, must be >=32 chars and distinct from JWT secrets
MFA_ENCRYPTION_SECRET="change-me-to-a-secure-32-byte-secret-for-mfa-encryption"

# ── Cookie & Session Architecture ───────────────────────────────────────────
# Options: strict | lax | none
# NOTE: Set to "none" in production if frontend (Vercel) and backend (Render)
# are on different domains (e.g. *.vercel.app and *.onrender.com).
# When using custom subdomains under the same apex domain (e.g. app.domain.com and api.domain.com),
# use "strict" or "lax".
COOKIE_SAME_SITE="strict"

# ── Durable Security Infrastructure (Mandatory in Production) ──────────────
# Redis connection for WebAuthn challenge replay prevention and account brute-force throttling
# In production, the server fails closed if REDIS_URL is missing.
REDIS_URL="redis://localhost:6379"

# ── WebAuthn / Passkey Relying Party Configuration ──────────────────────────
# RP_ID must match the frontend domain hostname (no protocol or port)
# e.g., "sentinel-vault.vercel.app" or "vault.company.com"
RP_ID="localhost"

# EXPECTED_ORIGIN must match the full frontend origin
# e.g., "https://sentinel-vault.vercel.app" or "https://vault.company.com"
EXPECTED_ORIGIN="http://localhost:3000"

# ── Enterprise KMS (Required if Enterprise OIDC SSO is enabled in Production) ─
# Production rejects LOCAL_DEV_KMS_KEY and requires real AWS KMS
# AWS_REGION="us-east-1"
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/your-key-id"
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Storage Backend for Encrypted File Attachments: local | s3
STORAGE_BACKEND="local"
